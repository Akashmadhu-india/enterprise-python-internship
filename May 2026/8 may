<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<title>Complete Project</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial;
}

header{
    background:black;
    color:white;
    padding:20px 60px;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

nav ul{
    display:flex;
    gap:20px;
}

nav ul li{
    list-style:none;
}

.hero{
    height:400px;

    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;

    background:#f2f2f2;
}

.cards{
    display:flex;
    justify-content:center;
    gap:20px;
    margin:40px;
}

.card{
    width:220px;
    padding:20px;
    background:white;
    border-radius:10px;
    box-shadow:0px 0px 10px lightgray;
}

footer{
    background:black;
    color:white;
    text-align:center;
    padding:20px;
}

</style>

</head>

<body>

<header>

    <h2>My Project</h2>

    <nav>

        <ul>
            <li>Home</li>
            <li>About</li>
            <li>Projects</li>
            <li>Contact</li>
        </ul>

    </nav>

</header>

<section class="hero">

    <h1>Frontend Project</h1>

    <p>Complete webpage implementation using HTML and CSS.</p>

</section>

<section class="cards">

    <div class="card">
        <h3>HTML</h3>
        <p>Structure design</p>
    </div>

    <div class="card">
        <h3>CSS</h3>
        <p>Responsive styling</p>
    </div>

    <div class="card">
        <h3>Project</h3>
        <p>Combined concepts</p>
    </div>

</section>

<footer>

    Internship Frontend Practice

</footer>

</body>
</html>