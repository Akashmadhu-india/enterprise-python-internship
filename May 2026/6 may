<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <title>Medium Clone</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        nav{
            height:80px;
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:0px 80px;
            border-bottom:1px solid black;
        }

        ul{
            display:flex;
            gap:20px;
            align-items:center;
        }

        li{
            list-style:none;
        }

        button{
            padding:10px 18px;
            border:none;
            background:black;
            color:white;
            border-radius:20px;
        }

    </style>

</head>

<body>

<nav>

    <h1>Medium</h1>

    <ul>

        <li>Our Story</li>
        <li>Membership</li>
        <li>Write</li>
        <li>Sign In</li>

        <button>Get Started</button>

    </ul>

</nav>

</body>
</html>