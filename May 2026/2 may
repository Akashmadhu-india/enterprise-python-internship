<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Furniture Ecommerce</title>

    <style>

        body{
            margin:0;
            font-family:Arial;
            background:#f5f5f5;
        }

        header{
            background:#111;
            color:white;
            padding:20px;
            text-align:center;
        }

        .products{
            display:flex;
            justify-content:center;
            gap:25px;
            margin-top:50px;
        }

        .card{
            background:white;
            width:250px;
            padding:20px;
            border-radius:12px;
            box-shadow:0px 0px 10px lightgray;
        }

        button{
            width:100%;
            padding:10px;
            background:black;
            color:white;
            border:none;
            margin-top:15px;
        }

    </style>

</head>

<body>

<header>
    <h1>Furniture Ecommerce</h1>
</header>

<section class="products">

    <div class="card">
        <h2>Chair</h2>
        <p>Comfortable office chair.</p>
        <button>Buy Now</button>
    </div>

    <div class="card">
        <h2>Sofa</h2>
        <p>Modern sofa design.</p>
        <button>Buy Now</button>
    </div>

</section>

</body>
</html>